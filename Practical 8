%{
#include <stdio.h>
#include <stdlib.h>
//Vithika Soaji 24070521192
int yylex(void);
void yyerror(const char *s);
%}
%token NUMBER
%left '+' '-'
%left '*' '/'
%right UMINUS
%%
input:
      /* empty */
    | input line
    ;
line:
      '\n'
    | expr '\n'   { printf("Result = %d\n", $1); }
    ;
expr:
      NUMBER              { $$ = $1; }
    | expr '+' expr       { $$ = $1 + $3; }
    | expr '-' expr       { $$ = $1 - $3; }
    | expr '*' expr       { $$ = $1 * $3; }
    | expr '/' expr       {
                            if ($3 == 0) {
                                printf("Error: Division by zero\n");
                                $$ = 0;
                            } else {
                                $$ = $1 / $3;
                            }
                          }
    | '(' expr ')'        { $$ = $2; }
    | '-' expr %prec UMINUS { $$ = -$2; }
    ;
%%
void yyerror(const char *s)
{
    printf("Error: %s\n", s);
}
int main(void)
{
    printf("Enter arithmetic expressions:\n");
    yyparse();
    return 0;
}

